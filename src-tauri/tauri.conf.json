{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Momentum Mascot",
  "version": "0.3.1",
  "identifier": "dev.keepgoing.momentum-mascot",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "Momentum Mascot",
        "width": 352,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "Momentum Mascot",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/bundle/icon.icns"],
    "category": "Utility",
    "copyright": "Art: LimeZu Modern Interiors, limezu.itch.io. Type: Departure Mono, OFL 1.1.",
    "shortDescription": "A pixel character who reflects how your side projects are going.",
    "longDescription": "A retro pixel character who lives in a tiny room on your desktop and reflects how your side projects are going. Reads one thing from each repository you point it at: when you last committed. No network, no accounts, no streaks.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
