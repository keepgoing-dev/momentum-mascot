**/.keepgoing/

# Tooling / OS files
.wrangler/
.DS_Store

# Mockups contain derived LimeZu Modern Interiors art.
# Licensed for use in the product, NOT for redistribution.
# See docs/spec-v2.md section 4.2.
docs/mockups/

# App Store screenshots, from tools/store-shots.sh. Same rule as docs/mockups: they are the
# composed rooms and the pet, so they are derived LimeZu art. Uploading them to the listing is
# presentation of the app; committing them here would be redistribution of the pack.
docs/store-shots/

# App assets are composited at build time from a local licensed copy of the pack.
# Same rule as docs/mockups: coordinates are committed, art is not.
# Regenerate with tools/build-app-assets.sh.
src/assets/
src-tauri/target/
src-tauri/gen/

# The tray icon is the one piece of art here that is not from the pack: it is drawn by
# tools/make-icons.sh and committed, so the app compiles without a licensed copy.
#
# The APPLICATION icon is a different case: it is the character at 1024px, so it IS derived from
# the pack and falls under the same rule as the rooms. Built by tools/make-app-icon.sh.
src-tauri/icons/bundle/

# Apple signing and notarization credentials. Real secrets, never committed.
# Copy tools/.release-env.example to create it. See docs/notarization.md.
tools/.release-env

# The Mac App Store build counter. App Store Connect rejects a reused build number, so this only
# ever goes up. Local because the store build is local, same as tools/.release-env.
tools/.mas-build

# A Mac App Store provisioning profile, if one is ever embedded. Not required (TN3125), and it
# carries the team's identifiers, so it is not committed.
tools/embedded.provisionprofile
