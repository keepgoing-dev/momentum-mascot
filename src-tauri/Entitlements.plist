<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WKWebView runs JavaScriptCore, which needs to map executable memory. Without this the
	     hardened runtime kills the webview on first script, and the popover comes up blank. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
